# Copy this file to .env for local development and fill in real values.
# Never commit .env. In Azure, these come from Container Apps secrets and settings.

# Anthropic API key, from a dedicated workspace with a monthly spend limit.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional. Which reader reads labels: "anthropic" (Claude through the Anthropic API),
# "foundry" (Claude in Microsoft Foundry, in Azure), or "ocr" (basic text reading only).
TTB_READER=anthropic

# For TTB_READER=foundry: the Foundry resource name. In Azure the app signs in with its
# managed identity. To try Foundry from a laptop, set a Foundry key instead.
TTB_FOUNDRY_RESOURCE=your-foundry-resource-name
ANTHROPIC_FOUNDRY_API_KEY=your-foundry-api-key-here
# Labels sent to the AI reader per minute, to stay inside a quota. 0 means no pacing.
TTB_LABELS_PER_MINUTE=0
# Labels read at the same time within a batch.
TTB_BATCH_CONCURRENCY=8
# "on" or "off": use basic text reading when Claude can't be reached.
TTB_OCR_FALLBACK=on

# Optional. The defaults were picked from the timing test in docs/measurements/.
TTB_CLAUDE_MODEL=claude-haiku-5-5
# "off" or "adaptive"
TTB_CLAUDE_THINKING=off
# low, medium, or high with thinking off; xhigh and max need thinking on.
TTB_CLAUDE_EFFORT=low
# Longest side, in pixels, of the images sent to Claude.
TTB_MAX_IMAGE_EDGE=1568
